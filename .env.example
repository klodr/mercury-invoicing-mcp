MERCURY_API_KEY=secret-token:mercury_production_xxxxxxxxxxxxxxxx

# Optional: point to the sandbox environment for testing
# MERCURY_API_BASE_URL=https://api-sandbox.mercury.com/api/v1

# Trusted address ranges for the SSRF guard. Only when a local proxy you
# trust answers DNS with its own addresses (Surge in enhanced mode hands
# out 198.18.0.0/15): those addresses are then accepted although they are
# not public. Comma-separated IPs or CIDR ranges; prefer a single IP. At
# most 131,072 addresses in all; loopback, link-local, 0.0.0.0/8 and the
# IPv6 ranges carrying an IPv4 are always refused. Unset by default.
# MCP_TRUSTED_CIDRS=198.18.0.0/15
